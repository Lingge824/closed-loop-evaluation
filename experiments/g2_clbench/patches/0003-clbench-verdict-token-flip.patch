 def test_invalid_feedback_mode_is_rejected():
     with pytest.raises(ValueError, match="feedback_mode"):
         _make_task("unknown")
+
+
+@pytest.mark.parametrize(
+    ("submitted", "true_verdict", "delivered_verdict"),
+    [
+        ("42", "PASS", "FAIL"),
+        ("7", "FAIL", "PASS"),
+    ],
+)
+def test_verdict_flip_changes_only_the_delivered_token(
+    submitted,
+    true_verdict,
+    delivered_verdict,
+):
+    clean = _make_task("verdict_only")
+    flipped = _make_task("verdict_only", verdict_flip_question_num=1)
+
+    clean_step = _answer(clean, submitted)
+    flipped_step = _answer(flipped, submitted)
+
+    assert clean._question_history == flipped._question_history
+    assert clean_step.instance_outcome == flipped_step.instance_outcome
+    assert clean_step.observation.metadata == flipped_step.observation.metadata
+    assert clean_step.observation.metadata["true_verdict"] == true_verdict
+
+    clean_lines = clean_step.observation.content.splitlines()
+    flipped_lines = flipped_step.observation.content.splitlines()
+    assert clean_lines[1:] == flipped_lines[1:]
+    assert clean_lines[0].replace(true_verdict, delivered_verdict) == flipped_lines[0]
+    assert clean_step.observation.content.count(true_verdict) == 1
+    assert flipped_step.observation.content.count(delivered_verdict) == 1
+
+    clean_result = clean.evaluate()
+    flipped_result = flipped.evaluate()
+    assert clean_result.metrics == flipped_result.metrics
+    assert clean_result.eval_metrics == flipped_result.eval_metrics
+    assert clean_result.instance_outcomes == flipped_result.instance_outcomes
+
+
+def test_verdict_flip_applies_only_at_the_configured_question_number():
+    task = _make_task("verdict_only", verdict_flip_question_num=2)
+
+    step = _answer(task, "42")
+
+    assert "EVALUATOR VERDICT: PASS" in step.observation.content
+
+
+def test_verdict_flip_requires_verdict_only_feedback():
+    with pytest.raises(ValueError, match="requires feedback_mode"):
+        _make_task("official", verdict_flip_question_num=1)
+
+
+@pytest.mark.parametrize("invalid_question_num", [0, -1, True, 1.5, "1"])
+def test_verdict_flip_rejects_invalid_question_numbers(invalid_question_num):
+    with pytest.raises(ValueError, match="positive integer"):
+        _make_task(
+            "verdict_only",
+            verdict_flip_question_num=invalid_question_num,
+        )
