+def _requires_groq_json_object_mode(model: str) -> bool:
+    """Use Groq's supported JSON mode for models without JSON-schema mode.
+
+    LiteLLM currently reports ``response_format`` support for Qwen 3.6 and
+    translates a Pydantic model into a forced function call. Groq documents
+    this model as supporting JSON Object Mode, not JSON-Schema Structured
+    Outputs, so schema-shaped tool calls can fail deterministically.
+    """
+    return model.lower() in _GROQ_JSON_OBJECT_MODELS
+
+
 def schema_to_prompt_instruction(schema: type[BaseModel]) -> str:
