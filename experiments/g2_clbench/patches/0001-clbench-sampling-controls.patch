+def _with_sampling_controls(
+    completion_kwargs: dict[str, Any],
+    *,
+    temperature: float | None,
+    seed: int | None,
+) -> dict[str, Any]:
+    """Add explicitly configured sampling controls to a completion request.
+
+    ``None`` means "leave provider behavior unchanged" and is intentionally
+    omitted instead of being forwarded. Returning a new dictionary makes it
+    safe to reuse this helper when a structured-output request falls back to
+    prompt-based JSON.
+    """
+    controlled_kwargs = dict(completion_kwargs)
+    if temperature is not None:
+        controlled_kwargs["temperature"] = temperature
+    if seed is not None:
+        controlled_kwargs["seed"] = seed
+    return controlled_kwargs
+
+
