diff --git a/tests/test_structured_output.py b/tests/test_structured_output.py
index 6447a34..c9c0b04 100644
--- a/tests/test_structured_output.py
+++ b/tests/test_structured_output.py
@@ -479,6 +479,75 @@ class TestExtractHttpStatus:
         assert calls["count"] == 1
 
 
+class TestSamplingControls:
+    def _stub_usage_builder(self, monkeypatch):
+        monkeypatch.setattr(
+            structured_output,
+            "build_usage_event_from_response",
+            lambda **kwargs: UsageEvent(
+                call_type="completion",
+                model="test-model",
+            ),
+        )
+
+    def test_completion_omits_unconfigured_sampling_controls(self, monkeypatch):
+        monkeypatch.setattr(
+            structured_output, "_model_supports_response_format", lambda _model: False
+        )
+        self._stub_usage_builder(monkeypatch)
+        captured = {}
+
+        def fake_completion(**kwargs):
+            captured.update(kwargs)
+            return FakeResponse('{"answer":"ok"}')
+
+        monkeypatch.setattr(structured_output.litellm, "completion", fake_completion)
+
+        parsed, _usage = completion_with_structured_output(
+            model="test-model",
+            messages=[{"role": "user", "content": "hello"}],
+            response_schema=RetryTestSchema,
+        )
+
+        assert parsed.answer == "ok"
+        assert "temperature" not in captured
+        assert "seed" not in captured
+
+    def test_sampling_controls_survive_schema_fallback(self, monkeypatch):
+        monkeypatch.setattr(
+            structured_output, "_model_supports_response_format", lambda _model: True
+        )
+        monkeypatch.setattr(
+            structured_output.litellm, "BadRequestError", FakeBadRequestError
+        )
+        self._stub_usage_builder(monkeypatch)
+        calls = []
+
+        def fake_completion(**kwargs):
+            calls.append(dict(kwargs))
+            if len(calls) == 1:
+                raise FakeBadRequestError("Compiled grammar is too large")
+            return FakeResponse('{"answer":"ok"}')
+
+        monkeypatch.setattr(structured_output.litellm, "completion", fake_completion)
+
+        parsed, _usage = completion_with_structured_output(
+            model="test-model",
+            messages=[{"role": "user", "content": "hello"}],
+            response_schema=RetryTestSchema,
+            temperature=0.0,
+            seed=17,
+        )
+
+        assert parsed.answer == "ok"
+        assert len(calls) == 2
+        assert "response_format" in calls[0]
+        assert "response_format" not in calls[1]
+        for call in calls:
+            assert call["temperature"] == 0.0
+            assert call["seed"] == 17
+
+
