+def test_icl_forwards_and_records_sampling_controls(monkeypatch):
+    captured = {}
+
+    def fake_completion(**kwargs):
+        captured.update(kwargs)
+        return DummyParsedResponse(), _usage_event(200)
+
+    monkeypatch.setattr(
+        icl_module, "completion_with_structured_output", fake_completion
+    )
+
+    system = ICLSystem(
+        model="test-model",
+        max_tokens=4_096,
+        provider_mode="litellm_chat",
+        temperature=0.0,
+        seed=17,
+    )
+    response = system.respond(Query(prompt="hello", response_schema=DummyAction))
+
+    assert captured["temperature"] == 0.0
+    assert captured["seed"] == 17
+    assert response.metadata["temperature"] == 0.0
+    assert response.metadata["seed"] == 17
+    artifacts = system.get_run_artifacts()
+    assert artifacts["temperature"] == 0.0
+    assert artifacts["seed"] == 17
+
+
+def test_icl_rejects_sampling_controls_on_native_provider_path():
