+        body = json.dumps(payload, separators=(",", ":")).encode("utf-8")
+        model = self.model.removeprefix("google/")
+        url = f"{_GEMINI_API_ROOT}/models/{model}:generateContent"
+        retries = 0
+        while True:
+            _pace_gemini_request_start(
+                model,
+                self.gemini_min_start_interval_seconds,
+            )
+            request = urllib.request.Request(
+                url,
+                data=body,
+                headers={
+                    "Content-Type": "application/json",
+                    "x-goog-api-key": api_key,
+                },
+                method="POST",
+            )
+            try:
+                with urllib.request.urlopen(
+                    request,
+                    timeout=self.request_timeout_seconds,
+                ) as response:
+                    return json.loads(response.read().decode("utf-8")), retries
