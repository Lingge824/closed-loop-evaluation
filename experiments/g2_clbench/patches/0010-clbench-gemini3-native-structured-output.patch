+def _pace_gemini_request_start(model: str, minimum_interval: float) -> None:
+    """Enforce the frozen process-wide start-to-start Gemini interval."""
+    if minimum_interval <= 0:
+        return
+    with _GEMINI_PACE_LOCK:
+        now = time.monotonic()
+        previous = _GEMINI_LAST_START_BY_MODEL.get(model)
+        if previous is not None:
+            wait = max(0.0, minimum_interval - (now - previous))
+            if wait:
+                time.sleep(wait)
+                now = time.monotonic()
+        _GEMINI_LAST_START_BY_MODEL[model] = now
+
+
+def _gemini_error_message(raw: str, status_code: int) -> str:
+    try:
+        body = json.loads(raw)
+    except json.JSONDecodeError:
+        body = {}
+    error = body.get("error", {}) if isinstance(body, dict) else {}
+    message = error.get("message") if isinstance(error, dict) else None
+    return str(message or f"Gemini API returned HTTP {status_code}")
+
+
+def _gemini_text_and_provider_record(
+    response: dict[str, Any],
+) -> tuple[str, dict[str, Any]]:
+    candidates = response.get("candidates") or []
+    if not candidates or not isinstance(candidates[0], dict):
+        raise RuntimeError("Gemini response did not include a candidate")
+    provider_record = candidates[0].get("content")
+    if not isinstance(provider_record, dict):
+        raise RuntimeError("Gemini response did not include model content")
+    if provider_record.get("role") not in {None, "model"}:
+        raise RuntimeError("Gemini response returned an invalid model-history role")
+    parts = provider_record.get("parts")
+    if not isinstance(parts, list) or not parts:
+        raise RuntimeError("Gemini response returned invalid model-history parts")
+    text = "".join(
+        str(part.get("text", ""))
+        for part in parts
+        if isinstance(part, dict) and not part.get("thought", False)
+    )
+    if not text.strip():
+        raise RuntimeError("Gemini response did not include final text output")
+    return text, deepcopy(provider_record)
+
+
+def _gemini_thought_signature_count(content: dict[str, Any]) -> int:
+    parts = content.get("parts")
+    if not isinstance(parts, list):
+        return 0
+    return sum(
+        1
+        for part in parts
+        if isinstance(part, dict) and isinstance(part.get("thoughtSignature"), str)
+    )
+
+
+def _gemini_finish_reason(response: dict[str, Any]) -> str | None:
+    candidates = response.get("candidates") or []
+    if not candidates or not isinstance(candidates[0], dict):
+        return None
+    value = candidates[0].get("finishReason")
+    return str(value) if value is not None else None
+
+
+def _gemini_frozen_cost(
+    model: str,
+    *,
+    input_tokens: int,
+    cached_input_tokens: int,
+    output_tokens: int,
+) -> float | None:
+    prices = _GEMINI_PRICES_PER_MILLION.get(model.removeprefix("google/"))
+    if prices is None:
+        return None
+    input_price, cached_price, output_price = prices
+    uncached_input_tokens = max(0, input_tokens - cached_input_tokens)
+    return (
+        uncached_input_tokens * input_price
+        + cached_input_tokens * cached_price
+        + output_tokens * output_price
+    ) / 1_000_000
+
