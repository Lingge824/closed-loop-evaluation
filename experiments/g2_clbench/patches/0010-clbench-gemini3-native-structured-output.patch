+    def _gemini_payload(
+        self,
+        messages: list[dict[str, Any]],
+        response_schema: type[BaseModel],
+    ) -> dict[str, Any]:
+        contents: list[dict[str, Any]] = []
+        signature_count = 0
+        for message in messages:
+            role = message.get("role")
+            if role == "system":
+                continue
+            provider_content = message.get("gemini_content")
+            if role == "assistant" and isinstance(provider_content, dict):
+                content = deepcopy(provider_content)
+                contents.append(content)
+                signature_count += _gemini_thought_signature_count(content)
+                continue
+            contents.append(
+                {
+                    "role": "model" if role == "assistant" else "user",
+                    "parts": [{"text": str(message.get("content", ""))}],
+                }
+            )
+        if signature_count:
+            self.state.hidden_state_used = True
+        self.state.metadata["replayed_thought_signature_count"] = signature_count
+        generation_config = {
+            "temperature": self.temperature,
+            "seed": self.seed,
+            "maxOutputTokens": self.gemini_max_output_tokens,
+            "responseMimeType": "application/json",
+            "responseJsonSchema": response_schema.model_json_schema(),
+            "thinkingConfig": {"thinkingLevel": self.gemini_thinking_level},
+        }
+        payload: dict[str, Any] = {
+            "contents": contents,
+            "generationConfig": generation_config,
+        }
+        if self.system_prompt:
+            payload["systemInstruction"] = {"parts": [{"text": self.system_prompt}]}
+        return payload
