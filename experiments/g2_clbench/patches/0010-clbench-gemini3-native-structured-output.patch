+                if retryable and retries < len(self.gemini_retry_delays_seconds):
+                    wait = self.gemini_retry_delays_seconds[retries]
+                    logger.warning(
+                        "Transient Gemini HTTP %d; retrying in %.1fs "
+                        "(attempt %d/%d): %s",
+                        exc.code,
+                        wait,
+                        retries + 1,
+                        len(self.gemini_retry_delays_seconds) + 1,
+                        message[:200],
+                    )
+                    retries += 1
+                    if wait:
+                        time.sleep(wait)
+                    continue
+                raise GeminiNativeError(message, status_code=exc.code) from exc
+            except OSError as exc:
+                if retries >= len(self.gemini_retry_delays_seconds):
+                    raise
+                wait = self.gemini_retry_delays_seconds[retries]
+                logger.warning(
+                    "Transient Gemini network error; retrying in %.1fs "
+                    "(attempt %d/%d): %s",
+                    wait,
+                    retries + 1,
+                    len(self.gemini_retry_delays_seconds) + 1,
+                    str(exc)[:300],
