+def test_icl_replay_rebuilds_exact_prefix_without_model_call(monkeypatch):
+    calls = []
+
+    def fake_completion(**kwargs):
+        calls.append(kwargs)
+        return DummyParsedResponse(), _usage_event(240)
+
+    monkeypatch.setattr(
+        icl_module, "completion_with_structured_output", fake_completion
+    )
+    monkeypatch.setattr(
+        icl_module.litellm,
+        "token_counter",
+        lambda *, model, messages: len(messages) * 100,
+    )
+
+    query = Query(prompt="first", response_schema=DummyAction)
+    clean = ICLSystem(
+        model="test-model",
+        max_tokens=4_096,
+        reserve_tokens=0,
+        provider_mode="litellm_chat",
+        temperature=0.0,
+        seed=17,
+    )
+    clean.respond(query)
+    clean_usage = clean.consume_usage_events()
+    assert len(clean_usage) == 1
+    assert clean_usage[0].input_tokens == 240
+    assistant_record = clean.messages[-1]["content"]
+
+    feedback = Observation(content="truthful feedback")
+    clean.observe(feedback)
+
+    replayed = ICLSystem(
+        model="test-model",
+        max_tokens=4_096,
+        reserve_tokens=0,
+        provider_mode="litellm_chat",
+        temperature=0.0,
+        seed=17,
+    )
+    calls_before_replay = len(calls)
+    replayed.replay_response(
+        query,
+        assistant_record=assistant_record,
+        input_tokens=240,
+    )
+    assert len(calls) == calls_before_replay
+    assert replayed.consume_usage_events() == []
+    replayed.observe(feedback)
+
+    assert replayed.messages == clean.messages
+    assert replayed.interaction_count == clean.interaction_count
+    assert replayed.get_truncation_stats() == clean.get_truncation_stats()
+    assert vars(replayed._token_budget) == vars(clean._token_budget)
+    assert (
+        replayed._provider_client.state_metadata()
+        == clean._provider_client.state_metadata()
+    )
+
+    next_query = Query(prompt="second", response_schema=DummyAction)
+    clean.respond(next_query)
+    replayed.respond(next_query)
+    assert calls[-2]["messages"] == calls[-1]["messages"]
+    assert calls[-2]["temperature"] == calls[-1]["temperature"] == 0.0
+    assert calls[-2]["seed"] == calls[-1]["seed"] == 17
+
+
+def test_icl_replay_rejects_native_provider_path():
+    system = ICLSystem(
+        model="gpt-5",
+        max_tokens=4_096,
+        provider_mode="auto",
+    )
+
+    with pytest.raises(ValueError, match="provider_mode='litellm_chat'"):
+        system.replay_response(
+            Query(prompt="hello", response_schema=DummyAction),
+            assistant_record='{"answer":"ok"}',
+            input_tokens=10,
+        )
+
+
+@pytest.mark.parametrize("invalid_input_tokens", [-1, True, 1.5, "10", None])
+def test_icl_replay_rejects_invalid_input_tokens(invalid_input_tokens):
+    system = ICLSystem(
+        model="test-model",
+        max_tokens=4_096,
+        provider_mode="litellm_chat",
+    )
+
+    with pytest.raises(ValueError, match="non-negative integer"):
+        system.replay_response(
+            Query(prompt="hello", response_schema=DummyAction),
+            assistant_record='{"answer":"ok"}',
+            input_tokens=invalid_input_tokens,
+        )
