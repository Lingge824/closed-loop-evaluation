+    def replay_response(
+        self,
+        query: Query,
+        *,
+        assistant_record: str,
+        input_tokens: int,
+    ) -> None:
+        """Rebuild one cached LiteLLM turn without making a provider call.
+
+        The caller must supply the exact serialized assistant record and the
+        API-reported prompt-token count from the clean turn. This follows the
+        same context insertion, truncation, and token-budget calibration path
+        as :meth:`respond`, but deliberately records no billable usage event.
+        """
+        if self._provider_client.state.provider != "litellm":
+            raise ValueError("replay_response requires provider_mode='litellm_chat'")
+        if not isinstance(assistant_record, str):
+            raise TypeError("assistant_record must be a string")
+        if (
+            isinstance(input_tokens, bool)
+            or not isinstance(input_tokens, int)
+            or input_tokens < 0
+        ):
+            raise ValueError("input_tokens must be a non-negative integer")
+
+        self._begin_turn(query)
+        self._note_prompt_token_usage(input_tokens)
+        self._finish_turn(assistant_record)
